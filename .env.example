# Copy this file to .env and put your real keys in. .env is gitignored.
#
# The placeholders below are deliberately not shaped like real keys. The first
# version of this file used realistic looking dummy values and the secret
# scanner in verify.py flagged it, which was the scanner being right. Describing
# the format in a comment is safer than imitating it, and it means a real key
# accidentally pasted into this file still gets caught.
#
# GEMINI_API_KEY  starts with AIza, 39 characters, free from
#                 https://aistudio.google.com/apikey
# GROQ_API_KEY    starts with gsk_, free from https://console.groq.com/keys
#
# Groq is optional. It is worth setting up, because comparing how two different
# models fail is a more interesting result than testing one model twice.

GEMINI_API_KEY=PUT_YOUR_GEMINI_KEY_HERE
GROQ_API_KEY=PUT_YOUR_GROQ_KEY_HERE
