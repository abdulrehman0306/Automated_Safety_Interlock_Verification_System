.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Regenerated by run_study.py in a couple of minutes, and the .npz is large
# enough to be annoying in a diff.
data/dataset.npz
data/model.pt

# Everything under results/ IS committed on purpose. The whole point of the
# project is the numbers, and somebody reading the repo should be able to see
# them without installing torch first.
#
# data/generations/ is committed too. Those are the raw LLM responses, and
# replaying them is the only way the study reproduces exactly, since the models
# are called at temperature 0.8 and never answer the same way twice.

# Run logs. They are useful locally and dangerous in a repo, because a stale log
# saying "11 of 11 passed" reads as current evidence when the code has moved on.
# Regenerate them with verify.py.
results/*.log
